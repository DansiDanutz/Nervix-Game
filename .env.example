# Copy to .env and fill in. Never commit a real .env.

DATABASE_URL=postgres://user:password@localhost:5432/nervix_world

# demo (default) | live
NERVIXPAY_MODE=demo
NERVIXPAY_BASE_URL=
NERVIXPAY_MERCHANT_ID=
NERVIXPAY_SIGNING_KEY=
NERVIXPAY_WEBHOOK_SECRET=

# Merchant AI employee provider (replaceable)
AGENT_MODEL_BASE_URL=
AGENT_MODEL_KEY=

# Optional voice
SPEECH_BASE_URL=
SPEECH_KEY=

# Server-only writer for the NervixPay receiver registry
WORLD_REGISTRY_URL=
